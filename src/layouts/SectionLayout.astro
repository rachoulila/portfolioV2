---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { contact } from "../config/site";

interface Props {
  title: string;
  description: string;
  accent: string; // ex: "var(--accent-design)"
  tagline: string;
}

const { title, description, accent, tagline } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={title} description={description}>
  <div style={`--section-accent:${accent}`}>
    <Header showBack />
    <main id="main" class="wrap section">
      <p class="section__tagline">{tagline}</p>
      <slot />
      <footer class="section__contact">
        <h2>{t("contact.title")}</h2>
        <a href={`mailto:${contact.email}`}>{t("contact.email")} — {contact.email}</a>
      </footer>
    </main>
  </div>
</BaseLayout>

<style>
  .section {
    padding-block: var(--space-6);
  }
  .section__tagline {
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: 1.02;
    max-width: 20ch;
    margin: 0 0 var(--space-6);
    color: var(--section-accent, var(--fg));
  }
  .section__contact {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: var(--rule);
  }
  .section__contact h2 {
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
    margin-bottom: var(--space-2);
  }
  .section__contact a {
    text-decoration: none;
    font-size: var(--text-h2);
  }
</style>
