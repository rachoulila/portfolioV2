---
import "../styles/global.css";
import { getLangFromUrl, useTranslatedPath } from "../i18n/utils";
import { site } from "../config/site";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = site.defaultOgImage } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const canonicalPath = Astro.url.pathname;
const frPath = translatePath(canonicalPath, "fr");
const enPath = translatePath(canonicalPath, "en");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — {site.name}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={new URL(canonicalPath, Astro.site)} />
    <link rel="alternate" hreflang="fr" href={new URL(frPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(frPath, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <slot />
  </body>
</html>
