---
import { getLangFromUrl, pick, useTranslatedPath } from "../i18n/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const cover = typeof project.data.cover === "string" ? project.data.cover : project.data.cover.src;
---

<a class="project-card" href={translatePath(`/${project.data.page}/${project.slug}/`)}>
  <div class="project-card__media">
    <img src={cover} alt="" loading="lazy" />
  </div>
  <div class="project-card__meta">
    <h3>{pick(project.data.title, lang)}</h3>
    <p>{project.data.client_name} — {project.data.year}</p>
    <div class="project-card__tags">
      {project.data.types.map((type) => <span class="tag">{type}</span>)}
    </div>
  </div>
</a>

<style>
  .project-card {
    display: block;
    text-decoration: none;
    color: var(--fg);
  }
  .project-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: var(--rule);
    margin-bottom: var(--space-2);
  }
  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition);
  }
  .project-card:hover .project-card__media img {
    transform: scale(1.03);
  }
  .project-card__meta h3 {
    font-size: 1.1rem;
    margin: 0 0 var(--space-1);
  }
  .project-card__meta p {
    margin: 0 0 var(--space-2);
    color: var(--fg-muted);
    font-size: var(--text-small);
  }
  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
</style>
