---
import { casquettes } from "../config/site";
import { getLangFromUrl, pick, useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div class="home-grid">
  {
    casquettes.map((c) => {
      const isSoon = c.kind === "soon";
      const href = isSoon ? undefined : c.kind === "internal" ? translatePath(c.href!) : c.href;
      const Tag = isSoon ? "div" : "a";
      return (
        <Tag
          class="home-grid__item"
          style={`--tile-color:${c.color}`}
          href={href}
          {...(c.kind === "external" ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          aria-disabled={isSoon ? "true" : undefined}
        >
          <span class="home-grid__label">{pick(c.label, lang)}</span>
          <span class="home-grid__tagline">{pick(c.tagline, lang)}</span>
          {isSoon && <span class="pill home-grid__badge">{t("status.soon")}</span>}
          {c.kind === "external" && <span class="pill home-grid__badge">↗</span>}
        </Tag>
      );
    })
  }
</div>

<style>
  .home-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  @media (min-width: 56rem) {
    .home-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .home-grid__item:nth-child(1),
    .home-grid__item:nth-child(2) {
      grid-column: span 2;
    }
  }
  .home-grid__item {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-1);
    min-height: 13rem;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: radial-gradient(
      ellipse at 30% 0%,
      color-mix(in srgb, var(--tile-color) 38%, var(--bg-elevated)),
      color-mix(in srgb, var(--tile-color) 12%, var(--bg-elevated)) 70%
    );
    border: 1px solid color-mix(in srgb, var(--tile-color) 30%, var(--border));
    text-decoration: none;
    color: var(--fg);
    transition: transform var(--transition), box-shadow var(--transition);
    overflow: hidden;
  }
  .home-grid__item:not([aria-disabled="true"]):hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -14px color-mix(in srgb, var(--tile-color) 70%, transparent);
  }
  .home-grid__item[aria-disabled="true"] {
    opacity: 0.7;
    cursor: default;
  }
  .home-grid__label {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: var(--text-h1);
    line-height: 0.95;
  }
  .home-grid__tagline {
    color: var(--fg-muted);
    font-size: var(--text-small);
    max-width: 28ch;
  }
  .home-grid__badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
</style>
