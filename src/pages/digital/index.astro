---
import { getCollection } from "astro:content";
import SectionLayout from "../../layouts/SectionLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = (await getCollection("projects", ({ data }) => data.page === "digital")).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year
);
---

<SectionLayout
  title="Digital & expériences"
  description="Installations, temps réel, dispositifs interactifs — projets de Rachel Truchot."
  accent="var(--accent-digital)"
  tagline="Digital & expériences."
>
  <p class="section-note">
    Le filtre par technique (VR, TouchDesigner, audio-réactif...) arrive à l'étape suivante — en
    attendant, voici l'ensemble des projets.
  </p>
  <div class="project-grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</SectionLayout>

<style>
  .section-note {
    color: var(--fg-muted);
    font-size: var(--text-small);
    margin-bottom: var(--space-5);
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-4);
  }
</style>
