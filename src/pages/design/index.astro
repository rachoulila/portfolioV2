---
import { getCollection } from "astro:content";
import SectionLayout from "../../layouts/SectionLayout.astro";
import FilterableProjects from "../../components/FilterableProjects.astro";
import ProjectPanel from "../../components/ProjectPanel.astro";

const projects = (await getCollection("projects", ({ data }) => data.page === "design")).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year
);
---

<SectionLayout
  title="Design"
  description="Identité visuelle, print, web, événementiel — projets de Rachel Truchot."
  accent="var(--accent-design)"
  tagline="Design graphique, print & digital."
>
  <FilterableProjects projects={projects} mode="design" />
</SectionLayout>

<ProjectPanel />
