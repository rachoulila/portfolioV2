---
import { getEntry } from "astro:content";
import SectionLayout from "../../layouts/SectionLayout.astro";
import Timeline from "../../components/Timeline.astro";
import { useTranslations } from "../../i18n/utils";

const cv = await getEntry("cv", "cv");
const t = useTranslations("fr");
---

<SectionLayout
  title="CV"
  description="Parcours de Rachel Truchot — formation et expériences."
  accent="var(--accent-digital)"
  tagline="Parcours."
>
  <p>
    <a class="pill" href={cv.data.pdf.fr} download>{t("cv.download")} (FR)</a>
  </p>
  <Timeline items={cv.data.timeline} />
</SectionLayout>
