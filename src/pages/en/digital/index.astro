---
import { getCollection } from "astro:content";
import SectionLayout from "../../../layouts/SectionLayout.astro";
import ProjectCard from "../../../components/ProjectCard.astro";

const projects = (await getCollection("projects", ({ data }) => data.page === "digital")).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year
);
---

<SectionLayout
  title="Digital & experiences"
  description="Installations, real-time, interactive devices — projects by Rachel Truchot."
  accent="var(--accent-digital)"
  tagline="Digital & experiences."
>
  <p class="section-note">
    The technique filter (VR, TouchDesigner, audio-reactive...) is coming in the next step —
    here's every project in the meantime.
  </p>
  <div class="project-grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</SectionLayout>

<style>
  .section-note {
    color: var(--fg-muted);
    font-size: var(--text-small);
    margin-bottom: var(--space-5);
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-4);
  }
</style>
