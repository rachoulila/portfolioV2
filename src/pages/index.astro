---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import HomeGrid from "../components/HomeGrid.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title="Rachel Truchot"
  description="Designeuse — design graphique, expériences digitales, recherche, musique."
>
  <Header />
  <main id="main" class="wrap home">
    <p class="home__intro">{t("home.intro")}</p>
    <HomeGrid />
  </main>
</BaseLayout>

<style>
  .home {
    padding-block: var(--space-6);
  }
  .home__intro {
    font-size: var(--text-h2);
    max-width: 42ch;
    margin-bottom: var(--space-5);
    color: var(--fg-muted);
  }
</style>
